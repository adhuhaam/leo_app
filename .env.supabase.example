# Leo Supabase project — copy to `.env` and fill in the two secrets marked YOUR_...
#
# Get YOUR_DB_PASSWORD: Supabase Dashboard → Project Settings → Database
#   (the password you chose when creating the project; reset if forgotten)
#
# Get YOUR_JWT_SECRET: Supabase Dashboard → Project Settings → API → JWT Secret
#
# Connection string path: Project Settings → Database → Connection string
#   → URI → Transaction pooler → port 6543

# ── Database (Transaction pooler — use for local dev + Drizzle) ───────────────
DATABASE_URL=postgresql://postgres.tdrzgemsyymsakigbazn:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# ── Supabase API ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://tdrzgemsyymsakigbazn.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRkcnpnZW1zeXltc2FraWdiYXpuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0MjgwOTAsImV4cCI6MjA5NTAwNDA5MH0.8wPuIpfSh_yUaoEyiVm-u_LO0pzaQJr44B-BdhoqTZ4
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# ── API server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# Use Supabase login (not local dev auth)
DEV_AUTH=false

# ── Web (Vite) ────────────────────────────────────────────────────────────────
VITE_DEV_AUTH=false
VITE_SUPABASE_URL=https://tdrzgemsyymsakigbazn.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRkcnpnZW1zeXltc2FraWdiYXpuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0MjgwOTAsImV4cCI6MjA5NTAwNDA5MH0.8wPuIpfSh_yUaoEyiVm-u_LO0pzaQJr44B-BdhoqTZ4
VITE_API_URL=http://localhost:8080

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_DEV_AUTH=false
EXPO_PUBLIC_SUPABASE_URL=https://tdrzgemsyymsakigbazn.supabase.co
